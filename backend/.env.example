# Copy to .env. Never commit .env.

# Encryption key for stored provider API keys (Fernet, 32 url-safe base64 bytes).
# Leave empty and KeyLens generates one in data/secret.key on first start.
KEYLENS_FERNET_KEY=

# Where the SQLite database lives.
KEYLENS_DB=data/keylens.db

# Origins allowed to call the API and the proxy from a browser.
KEYLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: a provider key used only by scripts/demo_traffic.py.
DEMO_GROQ_KEY=
